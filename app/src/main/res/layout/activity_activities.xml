<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O que fazer na viagem?"
        android:textColor="#1D4ED8"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tripSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#EFF6FF"
        android:padding="14dp"
        android:textColor="#1E3A8A"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Marque o que você pretende fazer:"
        android:textSize="17sp" />

    <CheckBox
        android:id="@+id/sightseeingCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:text="Passeio turístico" />

    <CheckBox
        android:id="@+id/museumCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Visitar museu" />

    <CheckBox
        android:id="@+id/restaurantCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Ir a restaurantes" />

    <CheckBox
        android:id="@+id/beachCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Visitar praia" />

    <Button
        android:id="@+id/summaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Ver resumo da viagem" />

</LinearLayout>
